# ─── UltrON Environment Configuration ───────────────────────
# Production-ready defaults for client PC deployment

# Application
APP_NAME=UltrON
APP_VERSION=1.1
DEBUG=false
HOST=0.0.0.0
PORT=8000

# ─── Database ────────────────────────────────────────────────
# SQLite (default — embedded, no extra setup required on client PC)
DB_TYPE=sqlite
DB_PATH=./ultron.db

# ─── Security ────────────────────────────────────────────────
# SECRET_KEY is auto-generated into secret.key on first run.
# Leave empty to auto-generate; never set a hardcoded value.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Default admin credentials — canonical source in config.py (DEFAULT_ADMIN_USERNAME / DEFAULT_ADMIN_PASSWORD)
# Change after first login! Generate a strong password (min 12 chars, mixed case + digits)
ADMIN_USERNAME=Master
ADMIN_PASSWORD=Ultronpoiu

# ─── WebSocket ───────────────────────────────────────────────
WS_LIVE_PUSH_INTERVAL=5

# ─── Polling Engine ──────────────────────────────────────────
POLLING_DEFAULT_INTERVAL=60
POLLING_MAX_RETRIES=3
POLLING_RETRY_DELAY=5

# ─── Averaging Engine ────────────────────────────────────────
AVG_1MIN=true
AVG_5MIN=true
AVG_15MIN=true
AVG_1HR=true
AVG_8HR=true
AVG_DAILY=true

# ─── Alarm Engine ────────────────────────────────────────────
ALARM_CHECK_INTERVAL=30

# ─── Report Storage ──────────────────────────────────────────
REPORTS_DIR=./reports
LOGS_DIR=./logs
BACKUPS_DIR=./backups
UPLOADS_DIR=./uploads

# ─── Email Alerts (optional) ─────────────────────────────────
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_RECIPIENTS=

# ─── RajAPI Central Sync ────────────────────────────────────
# API key assigned by RajAPI admin for this specific client site
RAJAPI_API_KEY=
RAJAPI_SYNC_ENABLED=true
# Station ID on RajAPI (must match the site name registered on rajapi.com)
RAJAPI_STATION_ID=default_station
