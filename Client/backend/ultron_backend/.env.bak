# ─── UltrON Environment Configuration ───────────────────────

APP_NAME=UltrON
APP_VERSION=1.0.36
DEBUG=false
HOST=0.0.0.0
PORT=8000

# ─── Database ────────────────────────────────────────────────
DB_TYPE=sqlite
DB_PATH=./ultron.db

# ─── Security ────────────────────────────────────────────────
# SECRET_KEY is auto-generated and persisted to secret.key on first run.
# Only set this to override — leave empty for auto-generation.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

ADMIN_USERNAME=Master
# REQUIRED: Set a strong password here before running.
ADMIN_PASSWORD=changeme123

# ─── WebSocket ───────────────────────────────────────────────
WS_LIVE_PUSH_INTERVAL=5

# ─── Polling Engine ──────────────────────────────────────────
POLLING_DEFAULT_INTERVAL=60
POLLING_MAX_RETRIES=3
POLLING_RETRY_DELAY=5

# ─── Averaging Engine ────────────────────────────────────────
AVG_1MIN=true
AVG_5MIN=true
AVG_15MIN=true
AVG_1HR=true
AVG_8HR=true
AVG_DAILY=true

# ─── Alarm Engine ────────────────────────────────────────────
ALARM_CHECK_INTERVAL=30

# ─── Report Storage ──────────────────────────────────────────
REPORTS_DIR=./reports
LOGS_DIR=./logs
BACKUPS_DIR=./backups
UPLOADS_DIR=./uploads

# ─── Email Alerts (optional) ─────────────────────────────────
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_RECIPIENTS=

# ─── Central Server Telemetry Sync ───────────────────────────
CENTRAL_API_URL=https://rajapi.com/api/v1/sync/
CENTRAL_API_KEY=

# ─── LED Board ───────────────────────────────────────────────
LED_HTTP_PORT=0
